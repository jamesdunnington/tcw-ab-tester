# Copy to hub/.env and fill in real values before `docker compose up`.
# Never commit the real .env file (see .gitignore).

# Public domain Caddy serves the hub on. Caddy auto-provisions a Let's
# Encrypt cert for this — it must be a real DNS name pointing at this VPS,
# with ports 80 and 443 reachable from the internet.
HUB_DOMAIN=ab.yourdomain.com

# Full public URL the WP plugin and browser tracker use — normally
# https://<HUB_DOMAIN>.
HUB_PUBLIC_URL=https://ab.yourdomain.com

# Comma-separated origins allowed to call the API with credentials. The
# dashboard is same-origin via Caddy in production, so this is usually only
# needed for local dev (http://localhost:5173).
ALLOWED_ORIGINS=

POSTGRES_DB=tcwab
POSTGRES_USER=tcwab
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (cookie-signing secret, any length >=32 chars)
SESSION_SECRET=

# openssl rand -hex 32  (MUST be exactly 32 bytes / 64 hex chars — AES-256-GCM key)
SECRET_ENCRYPTION_KEY=

# Host the Claude Desktop connector is served on. Needs its own DNS A/AAAA record pointing at this VPS,
# same as HUB_DOMAIN. Claude reaches it from Anthropic's side, so it must be public HTTPS.
MCP_DOMAIN=mcptest.yourdomain.com
