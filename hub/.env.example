# Copy to hub/.env and fill in real values before `docker compose up`.
# Never commit the real .env file (see .gitignore).

# Public domain Caddy serves the hub on. Caddy auto-provisions a Let's
# Encrypt cert for this — it must be a real DNS name pointing at this VPS,
# with ports 80 and 443 reachable from the internet.
HUB_DOMAIN=ab.yourdomain.com

# Full public URL the WP plugin and browser tracker use — normally
# https://<HUB_DOMAIN>.
HUB_PUBLIC_URL=https://ab.yourdomain.com

# Comma-separated origins allowed to call the API with credentials. The
# dashboard is same-origin via Caddy in production, so this is usually only
# needed for local dev (http://localhost:5173).
ALLOWED_ORIGINS=

POSTGRES_DB=tcwab
POSTGRES_USER=tcwab
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (cookie-signing secret, any length >=32 chars)
SESSION_SECRET=

# openssl rand -hex 32  (MUST be exactly 32 bytes / 64 hex chars — AES-256-GCM key)
SECRET_ENCRYPTION_KEY=

# Host the Claude Desktop connector is served on. Needs its own DNS A/AAAA record pointing at this VPS,
# same as HUB_DOMAIN. Claude reaches it from Anthropic's side, so it must be public HTTPS.
MCP_DOMAIN=mcptest.yourdomain.com

# --- Email: "winner found" notification (optional) ---
# Any SMTP server, as a URL: smtps://user:password@smtp.example.com:465  (or smtp://... for port 587 STARTTLS).
# Leave empty and no email is sent; nothing else changes.
SMTP_URL=
MAIL_FROM=TCW A/B Tester <no-reply@yourdomain.com>
# Comma-separated recipients. Empty = every hub user.
NOTIFY_EMAIL=

# --- Retention ---
# Raw events older than this are deleted daily. Aggregates (results, heatmaps, decisions, the library) are kept forever.
EVENT_RETENTION_DAYS=90
# Hourly stats snapshots older than this are thinned to one per day.
SNAPSHOT_FULL_DAYS=30

# --- Backups (a nightly pg_dump copied OFF this server) ---
# rclone destination as remote:bucket/path. The remote is named OFFSITE below; any S3-compatible storage works
# (Backblaze B2, Cloudflare R2, Wasabi, AWS S3, MinIO). Without BACKUP_REMOTE, dumps stay on this server only.
BACKUP_REMOTE=
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example-storage.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Example: BACKUP_REMOTE=OFFSITE:my-bucket/tcw-ab-tester
BACKUP_CRON=17 3 * * *
BACKUP_KEEP_DAYS=30
BACKUP_LOCAL_KEEP_DAYS=7
