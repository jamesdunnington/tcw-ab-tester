{$HUB_DOMAIN} {
	# Tracker + WP-facing endpoints, and the admin API — all served by the api container.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /wp/* {
		reverse_proxy api:4000
	}
	handle /ingest {
		reverse_proxy api:4000
	}
	handle /runtime-inline.js {
		reverse_proxy api:4000
	}
	# The visual editor and heatmap overlay: bundles loaded by the WP plugin, and their token-authenticated API.
	handle /editor.js {
		reverse_proxy api:4000
	}
	handle /heatmap.js {
		reverse_proxy api:4000
	}
	handle /editor/* {
		reverse_proxy api:4000
	}
	handle /tracker.js {
		reverse_proxy api:4000
	}
	handle /healthz {
		reverse_proxy api:4000
	}

	# Everything else: the dashboard SPA.
	handle {
		reverse_proxy dashboard:80
	}

	encode gzip
}

# The Claude Desktop connector: OAuth endpoints (/authorize /token /register /revoke, /.well-known/*)
# and the /mcp resource. Needs its own DNS record; Caddy provisions the certificate.
{$MCP_DOMAIN} {
	reverse_proxy mcp:4100
	encode gzip
}
